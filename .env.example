# Do not commit real secrets. Copy to .env.secrets on the host or inject via the platform secret store.
# Provider keys/OAuth.
# OPENAI_API_KEY is optional; Codex OAuth uses CODEX_AUTH_PATH instead.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: Amazon Bedrock native AWS auth region. Locally use AWS_PROFILE/AWS SSO;
# in AWS use pod identity/IRSA. No Bedrock API key is read.
BEDROCK_REGION=us-east-1
CODEX_AUTH_PATH=./codex-auth.json

# Caller-auth map for ingress. Each service gets its own token mapped to a caller name.
# Prefer hashed storage with scripts/register_consumer_key.py, which writes SHA-256(token) -> caller.
# Legacy plaintext map is still supported for local/dev compatibility; do not use known example tokens in production.
CALLER_KEYS_JSON={}
CALLER_KEYS_SHA256_JSON={}

# Dashboard/admin auth. Generate the password hash with:
# python - <<'PY'
# import getpass, hashlib
# print(hashlib.sha256(getpass.getpass('dashboard password: ').encode()).hexdigest())
# PY
DASHBOARD_PASSWORD_SHA256=
DASHBOARD_SESSION_SECRET=
# Trusted-header admin auth is disabled by default. Only set both vars behind a reverse proxy that strips client-supplied copies.
DASHBOARD_TRUSTED_USER_HEADER=
DASHBOARD_TRUSTED_USER_SECRET=
# Local-dev only: set to 1 to skip dashboard auth entirely (every request is a
# local admin). NEVER set this on a deployment reachable by anyone but you.
DASHBOARD_NO_AUTH=

# Host bind is loopback-only by compose.yml. Change only if fronted by private LB/service mesh.
LLM_ROUTER_HOST_PORT=8080
# Public OpenAI-compatible base URL shown in the dashboard's "key is ready" handoff blurb.
PUBLIC_BASE_URL=http://127.0.0.1:8080/v1
RATE_PER_MIN=600
BURST=200
LOG_LEVEL=INFO
# Complete router execution ceiling (all retries/fallbacks). Keep this below
# the outer load balancer/proxy timeout so callers receive a structured 504.
ROUTER_REQUEST_DEADLINE_MS=50000

# ============================================================================
# AntSeed marketplace (OPTIONAL — only with `docker compose --profile antseed`)
# ============================================================================
# AntSeed lets the router buy inference from a decentralized marketplace, paid in
# REAL USDC on Base mainnet from a hot wallet you control. Off by default.
#
# ⚠️  ALWAYS use a DEDICATED DEV WALLET here with a tiny balance — NEVER your
#     production wallet key. This var IS a private key: treat it like a password,
#     never commit it (.env / .env.secrets are gitignored).
#
# Setup (3 steps):
#   1. Generate a dev wallet:   ./scripts/gen-dev-wallet.sh   (prints the two
#      lines below; paste them into .env)
#   2. Bring it up:             docker compose --profile antseed up -d --build
#   3. Get the address to fund: docker compose exec antseed antseed buyer balance --json
#      then send a little USDC + ETH (gas) on **Base mainnet** to that address,
#      and `deposit` it into escrow from the dashboard Catalog (wallet cell).
ANTSEED_IDENTITY_HEX=
# Shared secret enabling the dashboard's wallet self-service (deposit/withdraw).
# Same value on the router and the antseed sidecar. Unset => those endpoints 503.
ANTSEED_CONTROL_TOKEN=
# Wide outer spend ceilings (USD per million tokens). The real per-call price gate
# is the caller's Σ_pol policy; these are just rails.
ANTSEED_MAX_INPUT=1000
ANTSEED_MAX_OUTPUT=1000
# Base RPC used to read the buyer wallet's raw USDC + ETH balance for the
# dashboard (escrow is the marketplace's; this is what's actually in the wallet
# to deposit/pay gas with). Defaults to a public Base endpoint; set ""/off to
# disable the on-chain read (dashboard then shows escrow only).
# NOTE this endpoint is UNTRUSTED — the funding keeper below treats its readings
# as vetoes and alerts only, never as permission to spend.
ANTSEED_WALLET_RPC_URL=
# --- funding autonomy (wallet_keeper.py) -------------------------------------
# The keeper reclaims stuck payment channels and tops the escrow up on its own.
# It SHIPS DARK: 0 = off (default). Arm it deliberately, from the dashboard
# Config tab or here. It also needs ANTSEED_CONTROL_URL + ANTSEED_CONTROL_TOKEN
# (the same pod-local sidecar control server the dashboard uses).
ANTSEED_KEEPER_ENABLED=0
# Stop OFFERING antseed routes below this escrow balance: a payment channel
# reserves ~1 USDC, so below one reserve every call 402s insufficient_deposits.
ANTSEED_MIN_AVAILABLE_USDC=1.1
# Deposit when escrow falls below the trigger (must be ABOVE the line above),
# this much per top-up, never leaving the hot wallet below the floor, never more
# than the daily cap in any rolling 24h, and never twice within the cooldown.
ANTSEED_TOPUP_TRIGGER_USDC=2.0
ANTSEED_TOPUP_AMOUNT_USDC=5
ANTSEED_TOPUP_WALLET_FLOOR_USDC=1
ANTSEED_TOPUP_DAILY_CAP_USDC=10
ANTSEED_TOPUP_COOLDOWN_S=900
# Force-close idle payment channels only when this much escrow is reserved AND
# the provider has served zero successful calls for an hour.
ANTSEED_RECLAIM_MIN_USDC=3
